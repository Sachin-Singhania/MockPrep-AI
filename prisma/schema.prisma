generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(uuid())
  name        String?
  email       String     @unique
  googleID    String?    @unique
  tokenExpiry DateTime?
  image       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  limit       Int?       @default(5)
  password    String?
  isAllowed   Boolean    @default(false)
  dashboards  Dashboard?
}

model Dashboard {
  id        String           @id @default(uuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id])
  Interview Interview[]
  Profile   Profile?
  Activity  RecentActivity[]

  @@index([userId])
}

model Profile {
  id             String     @id @default(uuid())
  tagline        String?
  about          String?
  Skills         String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  dashboardId    String     @unique
  dashboard      Dashboard  @relation(fields: [dashboardId], references: [id])
  Projects       Project[]
  WorkExperience WorkInfo[]

  @@index([dashboardId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String
  profileId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Profile     Profile  @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model WorkInfo {
  id        String  @id @default(uuid())
  company   String
  role      String
  startYear Int
  endYear   Int?
  profileId String
  Profile   Profile @relation(fields: [profileId], references: [id])

  @@index([profileId])
}

model Interview {
  id          String     @id @default(uuid())
  Jobtitle    String
  description String
  difficulty  Level
  skills      String
  experience  String
  status      Status
  startTime   DateTime   @default(now())
  endTime     DateTime?
  dashboardId String
  Analytics   Analytics?
  Dashboard   Dashboard  @relation(fields: [dashboardId], references: [id])
  Messages    Message[]

  @@index([dashboardId])
}

model Message {
  id          String       @id @default(uuid())
  interviewId String
  content     String
  Sender      Sender
  type        QuestionType
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Interview   Interview    @relation(fields: [interviewId], references: [id])
}

model Analytics {
  id                  String     @id @default(uuid())
  interviewId         String     @unique
  CommunicationScore  Int
  TechnicalScore      Int
  ProblemSolvingScore Int
  RelevanceScore      Int
  VocabularyScore     Int
  TechnicalKeywords   String[]
  KeyStrengths        String[]
  GrowthAreas         String[]
  InterviewSummary    String
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  overallScore        Int
  Interview           Interview  @relation(fields: [interviewId], references: [id])
  HRInsight           HrInsight?
  questions           Question[]
}

model Question {
  id          String    @id @default(uuid())
  question    String
  AnalyticsId String
  score       Int?
  topic       String
  Analytics   Analytics @relation(fields: [AnalyticsId], references: [id])
}

model HrInsight {
  id                     String    @id @default(uuid())
  TechnicalCompetency    String
  ExperienceLevel        String
  CulturalFit            String
  LearningPotential      String
  InterviewReadlineScore Int
  AnalyticsId            String    @unique
  Analytics              Analytics @relation(fields: [AnalyticsId], references: [id])
}

model RecentActivity {
  id          String             @id @default(uuid())
  dashboardId String
  type        RecentActivityType
  content     Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  Dashboard   Dashboard          @relation(fields: [dashboardId], references: [id])

  @@index([dashboardId, type])
}

enum Sender {
  USER
  ASSISTANT
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  QUESTION
  ANSWER
  END
  VALIDATION
  FORMALCHAT
}

enum Status {
  IN_PROGRESS
  COMPLETED
}

enum RecentActivityType {
  INTERVIEW
  PROFILE_UPDATED
  DASHBOARD_CREATED
}
